# ===========================
# Python .gitignore 模板
# ===========================

# ---------- 字节码 / 编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 分发 / 打包 ----------
*.egg
*.egg-info/
*.egg-link/
dist/
build/
sdist/
*.whl
*.tar.gz

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/
.venv3/

# ---------- 依赖锁定（可选，按需取消注释） ----------
# Pipfile.lock
# poetry.lock
# pdm.lock

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- 测试 / 覆盖率 ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/

# ---------- 类型检查 ----------
.mypy_cache/
.ruff_cache/
.pytype/

# ---------- 环境变量 / 密钥 ----------
.env
.env.*
!.env.example

# ---------- 日志 ----------
*.log
logs/

# Ragas 判分响应缓存（可重建，不入库）
/.cache/

# ---------- 数据库 / 本地存储 ----------
*.sqlite3
*.db
# 开发/验证用的临时 SQLite 库（无 Postgres 时用它跑通全栈）
_dev_verify.db
_dev_verify.db-journal

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db

# ---------- 本项目专属：不入远程仓库 ----------
# 语料、抽取产物与本地笔记一律保留在本地
/data/
CLAUDE.md
Prompt records.md
执行过程记录_*.md

# 云效流水线配置：内容是在控制台直接粘贴的，仓库里的这份只是本地底稿。
# 而且 sources.certificate.serviceConnection 是服务连接 UUID 字面值
# （该字段在解析期就要确定，无法用控制台变量注入），入库等于公开内部标识。
/.workflow/

# 前端
node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
# tsc 的增量编译缓存（构建产物，不该入库）
frontend/tsconfig.tsbuildinfo
# UI 验证脚本产出的截图
frontend/ui-verify.png